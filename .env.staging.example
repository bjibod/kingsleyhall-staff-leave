# Copy these names into the staging host's encrypted secret store. Never commit values.
NODE_ENV="production"
DEPLOYMENT_ENV="staging"
APP_URL="https://leave-staging.example.org"
APP_NAME="Kingsley Hall Staff Leave — STAGING"
ORGANISATION_NAME="Kingsley Hall"
APP_TIMEZONE="Europe/London"
DATABASE_URL="postgresql://STAGING_USER:REPLACE@STAGING_HOST:5432/kingsley_leave_staging?sslmode=require"
AUTH_SECRET="replace-with-an-independent-random-staging-secret-of-at-least-32-characters"
EMAIL_PROVIDER="microsoft-graph"
MICROSOFT_TENANT_ID="replace-in-vercel"
MICROSOFT_CLIENT_ID="replace-in-vercel"
MICROSOFT_CLIENT_SECRET="replace-in-vercel"
MICROSOFT_SENDER_EMAIL="leave-staging@khccc.com"
EMAIL_REPLY_TO="people@khccc.com"
EMAIL_ALLOWED_RECIPIENTS="approved.tester@khccc.com"
RELEASE_SHA="set-to-the-deployed-git-commit"
SENTRY_DSN="replace-with-staging-project-dsn"
NEXT_PUBLIC_SENTRY_DSN="replace-with-staging-project-dsn"
SENTRY_ENVIRONMENT="staging"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="staging"
SENTRY_TRACES_SAMPLE_RATE="0.2"
