# Names only. Store real values in Vercel Production Environment Variables.
NODE_ENV="production"
DEPLOYMENT_ENV="production"
APP_URL="https://leave.example.org"
APP_NAME="Kingsley Hall Staff Leave"
ORGANISATION_NAME="Kingsley Hall"
APP_TIMEZONE="Europe/London"
DATABASE_URL="postgresql://PRODUCTION_USER:REPLACE@PRODUCTION_HOST:5432/kingsley_leave?sslmode=require"
AUTH_SECRET="replace-with-an-independent-random-production-secret-of-at-least-32-characters"
EMAIL_PROVIDER="http"
EMAIL_API_URL="https://email-provider.example/api/send"
EMAIL_API_KEY="replace-in-vercel-production-environment"
EMAIL_FROM="Kingsley Hall Staff Leave <leave@example.org>"
# RELEASE_SHA is optional on Vercel; the health endpoint falls back to VERCEL_GIT_COMMIT_SHA.
